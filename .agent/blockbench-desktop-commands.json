{
  "schema": 1,
  "checkpoint": "goblin-knife-reference-smoke",
  "commands": [
    {
      "tool": "project_file",
      "label": "restore-knife-reference-smoke",
      "args": {
        "action": "open",
        "path": "$INPUT/checkpoint/goblin-knife-v2.bbmodel"
      }
    },
    {
      "tool": "reference_view",
      "label": "reference-full",
      "args": {
        "title": "Full image",
        "crop": [
          0,
          0,
          1,
          1
        ]
      }
    },
    {
      "tool": "capture_screenshot",
      "label": "actual-model-front",
      "args": {
        "angle": "north",
        "resolution": 960,
        "background": "#283039"
      },
      "images": true
    },
    {
      "tool": "reference_view",
      "label": "reference-detail",
      "args": {
        "title": "Upper region",
        "crop": [
          0.2,
          0,
          0.8,
          0.65
        ]
      }
    },
    {
      "tool": "desktop_capture",
      "label": "editor-detail"
    },
    {
      "tool": "reference_view",
      "label": "reference-reset",
      "args": {
        "title": "Full image",
        "crop": [
          0,
          0,
          1,
          1
        ]
      }
    }
  ]
}
