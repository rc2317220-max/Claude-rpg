--- /mnt/data/work_rpg_480/src/rustpg_elite_encounters.rs	1970-01-01 00:00:00.000000000 +0000
+++ /mnt/data/work_rpg_490/src/rustpg_elite_encounters.rs	2026-11-22 05:56:29.623395370 +0000
@@ -0,0 +1,77 @@
+//! Scaled hostile combat passives and health-based boss phases.
+//! Reproduces the behavior *pattern* of Remnant Mobs and Remnant Bosses, not
+//! their proprietary mob entities, animation assets or AI code.
+use crate::rustpg_scaling::{MobScale,Tier};
+
+#[derive(Clone,Copy,Debug,PartialEq)]
+pub struct Snapshot {
+    pub tier:Tier,
+    pub mutation:Option<&'static str>,
+    pub resistance:f64,
+    pub health_fraction:f64,
+    pub regen:f64,
+}
+impl Snapshot {
+    pub fn from_scale(scale:&MobScale)->Self {
+        Self{tier:scale.tier,mutation:scale.mutation,resistance:scale.resistance,
+             health_fraction:1.0,regen:scale.regen}
+    }
+    pub fn update_health(&mut self,health:f32,max:f32){
+        if health.is_finite() && max.is_finite() && max>0.0 {
+            self.health_fraction=f64::from((health/max).clamp(0.0,1.0));
+        }
+    }
+    pub fn boss_phase(self)->u8 {
+        if self.tier<Tier::MiniBoss {1}else{
+            crate::rustpg_scaling::boss_phase(1.0-self.health_fraction.clamp(0.0,1.0))
+        }
+    }
+    /// Boss phases increase aggression as life drops; first phase leaves
+    /// vanilla/other mod multipliers untouched. Never re-multiply base stats.
+    pub fn outgoing_multiplier(self)->f32 {
+        let phase=if self.tier>=Tier::Boss {self.boss_phase()}else{1};
+        let phase_mult=match phase{3=>1.35,2=>1.15,_=>1.0};
+        let berserk=crate::rustpg_evil_att::berserk_factor(self.mutation,
+            1.0-self.health_fraction.clamp(0.0,1.0)).min(1.5);
+        (phase_mult*berserk).min(2.0) as f32
+    }
+    /// Resistances from the saved MobScale were not previously used by combat.
+    /// Armor/toughness already apply natively and must not be counted again.
+    pub fn incoming_multiplier(self,damage_type:&str)->f32 {
+        let source=damage_type.rsplit(':').next().unwrap_or(damage_type);
+        if matches!(source,"out_of_world"|"generic_kill"|"starve"){return 1.0;}
+        (1.0-self.resistance.clamp(0.0,0.75)) as f32
+    }
+    /// Regeneration is absolute health per second, limited by maximum HP.
+    /// No healing from death; caller checks current health before applying.
+    pub fn heal_per_second(self,max_health:f32)->f32 {
+        if !max_health.is_finite() || max_health<=0.0 {return 0.0}
+        if self.tier<Tier::Fortified && self.mutation!=Some("regenerative") {return 0.0}
+        (self.regen.max(0.0).min(1000.0) as f32).min(max_health*0.02+0.5)
+    }
+}
+pub fn resolve(initial:f32,attacker:Option<Snapshot>,defender:Option<Snapshot>,kind:&str)->f32 {
+    if !initial.is_finite() {return 0.0}
+    let offense=attacker.map_or(1.0,Snapshot::outgoing_multiplier);
+    let defense=defender.map_or(1.0,|s|s.incoming_multiplier(kind));
+    (initial.max(0.0)*offense*defense).clamp(0.0,1.0e9)
+}
+#[cfg(test)]mod tests {
+    use super::*;
+    #[test]fn boss_enrage_has_real_hp_thresholds(){
+        let base=crate::rustpg_scaling::stats_for(20,Tier::Boss);
+        let mut snap=Snapshot::from_scale(&base);
+        assert_eq!(snap.boss_phase(),1); assert_eq!(snap.outgoing_multiplier(),1.0);
+        snap.update_health(55.0,100.0);assert_eq!(snap.boss_phase(),2);
+        snap.update_health(15.0,100.0);assert_eq!(snap.boss_phase(),3);
+        assert!(snap.outgoing_multiplier()>1.3);
+    }
+    #[test]fn resistance_does_not_negate_void_and_regen_has_cap(){
+        let mut snap=Snapshot::from_scale(&crate::rustpg_scaling::stats_for(50,Tier::Elite));
+        snap.resistance=1.0;
+        assert_eq!(snap.incoming_multiplier("minecraft:out_of_world"),1.0);
+        assert!((snap.incoming_multiplier("minecraft:mob_attack")-0.25).abs()<1e-6);
+        snap.regen=10000.0;
+        assert!(snap.heal_per_second(100.0)<=2.5);
+    }
+}
diff -ruN -x __pycache__ /mnt/data/work_rpg_480/src/rustpg_guard.rs /mnt/data/work_rpg_490/src/rustpg_guard.rs
--- /mnt/data/work_rpg_480/src/rustpg_guard.rs	1970-01-01 00:00:00.000000000 +0000
+++ /mnt/data/work_rpg_490/src/rustpg_guard.rs	2026-11-22 05:58:02.711543034 +0000
@@ -0,0 +1,95 @@
+//! Server-authoritative, latency-tolerant defensive action windows.
+//! Inspired by defensive timings in Epic Fight / Better Combat, not a port of
+//! either animation engine. No client can decide damage prevention.
+use std::collections::HashMap;
+use std::sync::{Mutex, OnceLock, atomic::{AtomicU64,Ordering}};
+use crate::rustpg_engine_stamina::Stamina;
+
+#[derive(Clone,Copy,Debug,PartialEq,Eq)]
+pub enum Stance { Parry, Dodge }
+impl Stance {
+    pub fn name(self)->&'static str {match self {Self::Parry=>"aparar",Self::Dodge=>"esquivar"}}
+    pub fn cost(self)->f64 {match self {Self::Parry=>14.0,Self::Dodge=>20.0}}
+    pub fn window(self)->u64 {match self {Self::Parry=>8,Self::Dodge=>11}}
+    pub fn cooldown(self)->u64 {match self {Self::Parry=>36,Self::Dodge=>58}}
+    pub fn multiplier(self)->f32 {match self {Self::Parry=>0.40,Self::Dodge=>0.30}}
+}
+#[derive(Clone,Copy,Debug)]
+struct Entry {stance:Stance,until:u64,cooldown:u64,unused:bool}
+#[derive(Default)]
+pub struct Engine {entries:HashMap<(String,u32),Entry>}
+impl Engine {
+    pub fn activate(&mut self,dim:&str,entity:u32,stance:Stance,now:u64,
+                    stamina:&mut Stamina)->Result<(),String> {
+        if dim.is_empty() || entity==0 {return Err("Entidade inválida".into());}
+        let key=(dim.to_owned(),entity);
+        if self.entries.get(&key).is_some_and(|v|now<v.cooldown) {
+            return Err("Ação defensiva em recarga".into());
+        }
+        if stamina.exhausted || !stamina.current.is_finite() || stamina.current < stance.cost() {
+            return Err("Stamina insuficiente para defender".into());
+        }
+        if !stamina.consume(stance.cost()) {return Err("Stamina insuficiente".into());}
+        self.entries.insert(key,Entry{stance,until:now.saturating_add(stance.window()),
+                                     cooldown:now.saturating_add(stance.cooldown()),unused:true});
+        Ok(())
+    }
+    /// A successful reduction consumes the window; fire, starvation, void,
+    /// poison and unrelated sources cannot accidentally consume a parry.
+    pub fn on_hit(&mut self,dim:&str,entity:u32,kind:&str,now:u64)->f32 {
+        let Some(entry)=self.entries.get_mut(&(dim.to_owned(),entity))else{return 1.0};
+        if !entry.unused || now>entry.until {return 1.0;}
+        let damage_type=kind.rsplit(':').next().unwrap_or(kind);
+        let blocked=matches!(damage_type,"fall"|"fire"|"in_fire"|"on_fire"|
+            "lava"|"wither"|"starve"|"drown"|"freeze"|"out_of_world"|
+            "magic"|"indirect_magic"|"thorns"|"cactus"|"sweet_berry_bush");
+        if blocked {return 1.0;}
+        let ranged=matches!(damage_type,"arrow"|"trident"|"fireball"|"mob_projectile"|
+            "unattributed_fireball"|"explosion"|"player_explosion");
+        if entry.stance==Stance::Parry && ranged{return 1.0;}
+        entry.unused=false;
+        entry.stance.multiplier()
+    }
+    pub fn remove(&mut self,dim:&str,entity:u32){self.entries.remove(&(dim.to_owned(),entity));}
+    pub fn cleanup(&mut self,now:u64){self.entries.retain(|_,v|now<v.cooldown);}
+}
+static INSTANCE:OnceLock<Mutex<Engine>>=OnceLock::new();
+static TICK:AtomicU64=AtomicU64::new(0);
+fn inner()->&'static Mutex<Engine>{INSTANCE.get_or_init(||Mutex::new(Engine::default()))}
+pub fn current_tick()->u64 {TICK.load(Ordering::Relaxed)}
+pub fn set_tick(tick:u64){TICK.store(tick,Ordering::Relaxed);if tick%40==0 {
+    inner().lock().unwrap_or_else(|e|e.into_inner()).cleanup(tick);
+}}
+pub fn activate(dim:&str,entity:u32,stance:Stance,stamina:&mut Stamina)->Result<String,String>{
+    let tick=TICK.load(Ordering::Relaxed);
+    inner().lock().unwrap_or_else(|e|e.into_inner())
+        .activate(dim,entity,stance,tick,stamina)?;
+    Ok(format!("{}: janela de {} ticks, recarga {} ticks",stance.name(),
+        stance.window(),stance.cooldown()))
+}
+pub fn on_hit(dim:&str,entity:u32,kind:&str)->f32 {
+    let tick=TICK.load(Ordering::Relaxed);
+    inner().lock().unwrap_or_else(|e|e.into_inner()).on_hit(dim,entity,kind,tick)
+}
+pub fn remove(dim:&str,entity:u32){inner().lock().unwrap_or_else(|e|e.into_inner()).remove(dim,entity);}
+#[cfg(test)] mod tests {
+    use super::*;
+    #[test] fn only_authorized_hits_reduce_and_reductions_are_one_shot(){
+        let mut e=Engine::default();let mut s=Stamina::new(100.0,0.0,0);
+        e.activate("overworld",7,Stance::Parry,100,&mut s).unwrap();
+        assert_eq!(e.on_hit("overworld",7,"minecraft:arrow",102),1.0);
+        assert_eq!(e.on_hit("overworld",7,"minecraft:mob_attack",103),0.4);
+        assert_eq!(e.on_hit("overworld",7,"minecraft:mob_attack",104),1.0);
+        assert!(e.activate("overworld",7,Stance::Dodge,110,&mut s).is_err());
+        e.activate("overworld",7,Stance::Dodge,136,&mut s).unwrap();
+        assert_eq!(e.on_hit("overworld",7,"minecraft:arrow",140),0.3);
+        assert_eq!(e.on_hit("overworld",7,"minecraft:lava",141),1.0);
+    }
+    #[test] fn cost_is_never_spent_for_rejected_requests(){
+        let mut e=Engine::default();let mut s=Stamina::new(100.0,0.0,0);
+        e.activate("overworld",7,Stance::Parry,100,&mut s).unwrap();
+        let balance=s.current;
+        assert!(e.activate("overworld",7,Stance::Parry,102,&mut s).is_err());
+        assert_eq!(s.current,balance);
+    }
+}
