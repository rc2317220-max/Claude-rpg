+<!doctype html><html lang="pt-BR"><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width,initial-scale=1"/>
+<title>Claude RPG · Editor offline</title>
+<style>
+:root{color-scheme:dark;font-family:system-ui,-apple-system,sans-serif;background:#111726;color:#e9edff}
+*{box-sizing:border-box}body{margin:0;max-width:1000px;margin-inline:auto;padding:14px}h1{font-size:1.3rem}h2{font-size:1rem}p,small{color:#aebbd6;line-height:1.4}.toolbar,.actions{display:flex;gap:8px;flex-wrap:wrap;margin:12px 0}button,select,input,textarea{font:inherit;color:inherit;background:#202b42;border:1px solid #485977;border-radius:9px;padding:10px;min-height:40px}button{cursor:pointer}button:hover{background:#31445f}.primary{background:#3757ad}textarea{width:100%;resize:vertical;min-height:260px;font-family:ui-monospace,monospace;font-size:13px;line-height:1.5}label{font-size:.85rem;display:flex;flex-direction:column;gap:4px;flex:1;min-width:140px}section{background:#182236;border:1px solid #33445c;padding:14px;border-radius:12px}#graph{height:310px;width:100%;background:#121a2b;border:1px solid #3a4b64;border-radius:10px;touch-action:none}#notice{white-space:pre-wrap;min-height:45px;color:#c4e5bb}#notice.error{color:#ffc2bc}.hidden{display:none}code{color:#d0bbff}footer{padding:20px 0}
+</style></head><body>
+<h1>Claude RPG — Editor offline</h1>
+<p>Funciona no navegador Android, sem internet. Crie e valide árvores, missões e scripts de XP. Os arquivos <code>.json</code> de missões/árvores são projetos editáveis e <strong>não são carregados automaticamente pelo mod</strong>; o script <code>.crpgx</code> é compatível com a VM existente.</p>
+<div class="toolbar"><button data-tab="quests" class="primary">Missões</button><button data-tab="skills">Skill trees</button><button data-tab="script">Script de XP</button></div>
+<section>
+<div class="actions"><button id="validate">Validar</button><button id="export" class="primary">Exportar arquivo</button><button id="format">Formatar JSON</button><label style="flex:1">Importar arquivo<input id="import" type="file" accept=".json,.crpgx,.txt"/></label></div>
+<div id="graphWrap"><h2>Prévia do grafo · arraste os nós</h2><svg xmlns="http://www.w3.org/2000/svg" id="graph" viewBox="0 0 800 320" aria-label="Visualização editável das ligações"></svg></div>
+<h2 id="panelTitle">Missões</h2>
+<textarea id="source" spellcheck="false" aria-label="Dados editáveis"></textarea>
+<div id="scriptHelp" class="hidden"><p>Formato do script reconhecido pela VM: <code>id=...</code>, <code>api=1</code>, <code>on=mine|fish|trade|craft|kill|...</code>, comandos <code>units</code>, <code>const N</code>, <code>mul</code>, <code>min 64</code>, <code>award mining</code>.</p></div>
+<div id="notice" role="status"></div>
+</section>
+<footer><small>O editor nunca envia arquivos a um servidor. Faça backup do mundo antes de recompilar o mod.</small></footer>
+<script>
+'use strict';
+const defaults={
+quests:[{id:'forest',title:'Primeiros recursos',event:'logs',amount:16,needs:[],xp:100,points:1,x:110,y:90},{id:'bench',title:'Criar bancada',event:'craft_table',amount:1,needs:['forest'],xp:120,points:1,x:380,y:90},{id:'stone',title:'Era da pedra',event:'stone',amount:32,needs:['bench'],xp:180,points:2,x:650,y:90}],
+skills:[{id:'power.fury',name:'Ímpeto',tree:'powers',attribute:'power.fury',max_rank:1,prereqs:[],exclusions:[],x:140,y:100},{id:'power.barrier',name:'Égide',tree:'powers',attribute:'power.barrier',max_rank:1,prereqs:[],exclusions:[],x:390,y:100},{id:'power.siphon',name:'Sifão',tree:'powers',attribute:'power.siphon',max_rank:1,prereqs:[],exclusions:[],x:640,y:100}],
+script:'id=claude_rpg:custom_mining\napi=1\non=mine\nunits\nconst 2\nmul\nmin 24\naward mining\n'};
+let tab='quests';const source=document.getElementById('source'),graph=document.getElementById('graph'),notice=document.getElementById('notice');
+const drafts={quests:JSON.stringify(defaults.quests,null,2),skills:JSON.stringify(defaults.skills,null,2),script:defaults.script};
+function setNotice(text,error=false){notice.textContent=text;notice.className=error?'error':''}
+function changeTab(next){drafts[tab]=source.value;tab=next;source.value=drafts[tab];document.getElementById('panelTitle').textContent={quests:'Missões e objetivos',skills:'Nós e conexões',script:'Script de XP executável'}[tab];document.getElementById('scriptHelp').classList.toggle('hidden',tab!=='script');document.getElementById('graphWrap').classList.toggle('hidden',tab==='script');setNotice('');renderGraph()}
+for(const btn of document.querySelectorAll('[data-tab]'))btn.addEventListener('click',()=>changeTab(btn.dataset.tab));
+function schema(){const arr=JSON.parse(source.value);if(!Array.isArray(arr)||arr.length>500||!arr.length)throw Error('A raiz deve ser um array com 1 a 500 entradas');const ids=new Set();for(const row of arr){if(!row||typeof row!=='object'||typeof row.id!=='string'||!/^[a-z0-9._-]{2,80}$/.test(row.id))throw Error('ID inválido (use a-z, 0-9, ponto, hífen e sublinhado)');if(ids.has(row.id))throw Error('ID repetido: '+row.id);ids.add(row.id)}const map=new Map(arr.map(v=>[v.id,v]));for(const row of arr){const edges=tab==='quests'?(row.needs||[]):(row.prereqs||[]).map(p=>typeof p==='string'?p:p.id);if(!Array.isArray(edges)||edges.length>32)throw Error('Dependências inválidas em '+row.id);for(const e of edges)if(!map.has(e))throw Error('Referência inexistente: '+row.id+' → '+e);if(tab==='quests'&&(!Number.isInteger(row.amount)||row.amount<1||row.amount>1e6||!Number.isInteger(row.xp)||row.xp<0))throw Error('Quantidade/XP inválidos em '+row.id);if(tab==='skills'&&(!Number.isInteger(row.max_rank)||row.max_rank<1||row.max_rank>1e6))throw Error('max_rank inválido: '+row.id)}const seen=new Set(),active=new Set();function walk(id){if(active.has(id))throw Error('Ciclo de dependência em '+id);if(seen.has(id))return;active.add(id);const node=map.get(id);for(const e of tab==='quests'?(node.needs||[]):(node.prereqs||[]).map(p=>typeof p==='string'?p:p.id))walk(e);active.delete(id);seen.add(id)}for(const id of ids)walk(id);return arr}
+function scriptCheck(){const src=source.value,lines=src.split(/\r?\n/).map(x=>x.trim()).filter(x=>x&&!x.startsWith('#'));if(src.length>4096||lines.length>35)throw Error('Script excede limites de tamanho');if(!lines.some(x=>x==='api=1')||!lines.some(x=>/^id=[a-z0-9._-]+:[a-z0-9._-]+$/.test(x))||!lines.some(x=>/^on=(craft|fish|trade|tame|brew|enchant|smith|cook|smelt|mine|woodcut|harvest|kill)$/.test(x)))throw Error('Cabeçalho inválido');if(!lines.some(x=>/^award (sword|axe|bow|crossbow|mace|trident|spear|unarmed|survival|mining|excavation|woodcutting|farming|fishing|hunting|husbandry|exploration|looting|enchanting|smithing|crafting|alchemy|cooking|trading|taming)$/.test(x)))throw Error('Falta instrução award ou profissão não reconhecida');return lines}
